{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "declarationDir": "dist",
    "outDir": "dist",
    "rootDir": ".",
    "paths": {}
  },
  "include": ["src", "vael/theme.ts", "vael/palette.ts", "vael/foundation-tokens.ts"],
  "exclude": ["node_modules", "dist", "stories", ".storybook"]
}
