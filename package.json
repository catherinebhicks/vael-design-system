{
  "name": "vael-design-system",
  "version": "0.1.0",
  "description": "Vael — an MUI v7 component library & design system, documented in Storybook",
  "author": "Catherine Hicks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catherinebhicks/vael-design-system.git"
  },
  "homepage": "https://github.com/catherinebhicks/vael-design-system#readme",
  "bugs": {
    "url": "https://github.com/catherinebhicks/vael-design-system/issues"
  },
  "keywords": [
    "design-system",
    "component-library",
    "mui",
    "react",
    "storybook",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "vael",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "chromatic": "chromatic --exit-zero-on-changes",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@mui/lab": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@mui/x-data-grid": "^8.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-dropzone": "^15.0.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/dm-mono": "^5.2.7",
    "@fontsource/dm-sans": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-designs": "^11.1.3",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "ag-grid-community": "^35.2.1",
    "ag-grid-enterprise": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "chromatic": "^17.8.0",
    "highcharts": "^12.6.0",
    "highcharts-react-official": "^3.2.3",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.3.6",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "peerDependencies": {
    "ag-grid-community": ">=31.0.0",
    "ag-grid-enterprise": ">=31.0.0",
    "ag-grid-react": ">=31.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "ag-grid-community": {
      "optional": true
    },
    "ag-grid-enterprise": {
      "optional": true
    },
    "ag-grid-react": {
      "optional": true
    }
  }
}
